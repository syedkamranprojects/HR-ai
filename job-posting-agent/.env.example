# Groq (OpenAI-compatible), same provider as on-boarding-agent/brain
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# HTTP port (defaults to 8081 so it can run alongside brain/ on 8080)
PORT=8081

# Where persisted postings/candidates and resume-intake folders live
# (defaults to ./data and ./inbox -- both gitignored)
DATA_DIR=data
RESUME_INBOX_DIR=inbox

# Optional: SMTP for actually sending the screening-interview email on
# approval. Leave unset to use the safe default (LoggingEmailSender), which
# logs what would be sent instead of sending it -- no credentials needed to
# try the feature out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Centegy Technologies HR
