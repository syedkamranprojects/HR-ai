# LiveKit server/project (from your LiveKit Cloud project or self-hosted server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT / TTS providers
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
SPEECHMATICS_API_KEY=

# STT input language (Deepgram nova-3 language code). Default is en-US.
# Set to "ur" if the employee will speak Urdu -- the agent still always
# responds in English regardless of this setting.
DEEPGRAM_LANGUAGE=en-US

# Which provider to use for STT/TTS. Defaults keep the working Deepgram +
# Cartesia path; set to "speechmatics" to switch either one (recurring free
# tier, no credit card -- but its TTS doesn't support streaming, so expect
# slightly higher latency than Cartesia).
STT_PROVIDER=deepgram
TTS_PROVIDER=cartesia
# Only used when the provider above is "speechmatics":
SPEECHMATICS_LANGUAGE=en
SPEECHMATICS_VOICE=sarah

# The Java brain service (OpenAI-compatible endpoint), see ../brain
BRAIN_BASE_URL=http://localhost:8080/v1
# Same service, without the /v1 suffix -- used for the admin-configured
# employee-info lookup that personalizes the greeting.
BRAIN_ROOT_URL=http://localhost:8080
